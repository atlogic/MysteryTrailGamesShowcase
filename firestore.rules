rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == "atlogic.eu@gmail.com" && request.auth.token.email_verified == true);
    }

    // Loose validation for games
    function isValidGame(data) {
      return data.id is string && 
             data.parentId is string &&
             data.checkpoints is list &&
             data.createdAt is number;
    }

    // Loose validation for sessions
    function isValidSession(data) {
      return data.id is string &&
             data.gameId is string &&
             data.parentId is string &&
             data.timestamp is number;
    }

    match /games/{gameId} {
      // Anyone can read a game by ID
      allow get: if true;
      
      // Owner or Admin can list, create, update, delete
      allow list: if isAuthenticated() && (resource.data.parentId == request.auth.uid || isAdmin());
      
      allow create: if isAuthenticated() && 
                      (request.resource.data.parentId == request.auth.uid || isAdmin()) &&
                      isValidGame(request.resource.data);
                      
      allow update: if isAuthenticated() && 
                      (resource.data.parentId == request.auth.uid || isAdmin()) &&
                      (request.resource.data.parentId == request.auth.uid || isAdmin()) &&
                      isValidGame(request.resource.data);
                      
      allow delete: if isAuthenticated() && (resource.data.parentId == request.auth.uid || isAdmin());
    }

    match /sessions/{sessionId} {
      // Anyone can create a session (to save game results)
      allow create: if isValidSession(request.resource.data);
      
      // Only the game owner or admin can read the sessions
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.parentId == request.auth.uid
      );

      // Sub-collection for individual checkpoint results
      match /results/{resultId} {
        // Anyone can create a result as part of a session
        allow create: if true;
        
        // Only the game owner or admin can read the results
        allow read: if isAuthenticated() && (
          isAdmin() || 
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.parentId == request.auth.uid
        );
      }
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
  }
}
