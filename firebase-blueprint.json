{
  "entities": {
    "Game": {
      "title": "Game",
      "description": "A game configuration with checkpoints",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "parentId": { "type": "string" },
        "checkpoints": { "type": "array" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "parentId", "checkpoints", "createdAt"]
    },
    "Session": {
      "title": "Session",
      "description": "A completed game session metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gameId": { "type": "string" },
        "parentId": { "type": "string" },
        "teamName": { "type": "string" },
        "members": { "type": "array" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "gameId", "parentId", "teamName", "members", "timestamp"]
    },
    "CheckpointResult": {
      "title": "CheckpointResult",
      "description": "Individual result for a checkpoint in a session",
      "type": "object",
      "properties": {
        "checkpointId": { "type": "string" },
        "photo": { "type": "string", "description": "Base64 encoded image" },
        "audio": { "type": "string", "description": "Base64 encoded audio" },
        "bestPerformer": { "type": "string" }
      },
      "required": ["checkpointId"]
    }
  },
  "firestore": {
    "/games/{gameId}": {
      "schema": "Game",
      "description": "Storage for shared games"
    },
    "/sessions/{sessionId}": {
      "schema": "Session",
      "description": "Storage for game session metadata"
    },
    "/sessions/{sessionId}/results/{resultId}": {
      "schema": "CheckpointResult",
      "description": "Storage for individual checkpoint results with media"
    }
  }
}
